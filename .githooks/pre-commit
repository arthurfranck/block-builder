#!/bin/sh
# Git pre-commit hook (ADR 0010): runs for every commit, Arthur's and Claude's.
# If an app, test or tooling file is staged: refuse unstaged changes in those files (the checks run on the working
# tree, so they must match what is committed), check the bundle is built from src/, then run lint, the format check,
# the engine tests and the desktop Chrome tests. Any failure blocks the commit.
# Enabled by `npm install` / `npm ci` (the "prepare" script sets core.hooksPath to .githooks).
cd "$(git rev-parse --show-toplevel)" || exit 1
# Node may live outside the default PATH (see CLAUDE.md)
[ -d "$HOME/.local/node/bin" ] && PATH="$HOME/.local/node/bin:$PATH"
# BB-91: GitHub runs no checks at all for a workflow it can't read, so a broken one makes a PR look green.
# When a workflow file is staged, check the staged copies (not the working tree) first; this takes under a second.
if ! git diff --cached --quiet -- .github/workflows; then
  if ! command -v node >/dev/null 2>&1 || [ ! -d node_modules/yaml ]; then
    echo "Commit blocked: node or node_modules is missing here, so the workflow files can't be checked. Run 'npm ci' in $(pwd), then commit again." >&2
    exit 1
  fi
  wf=$(mktemp -d)
  git ls-files -z -- .github/workflows | xargs -0 git checkout-index --prefix="$wf/" --
  if ! out=$(node scripts/check-workflows.mjs "$wf/.github/workflows" 2>&1); then
    rm -rf "$wf"
    printf '%s\n' "$out" | sed "s|$wf/||" >&2
    echo "Commit blocked: fix the staged workflow file(s) above (a name containing ': ' needs quotes)." >&2
    exit 1
  fi
  rm -rf "$wf"
fi
CHECKED="index.html theme.js src app.js app.js.map tests scripts package.json package-lock.json playwright.config.ts eslint.config.mjs tsconfig.json tsconfig.app.json .prettierrc.json"
# shellcheck disable=SC2086
git diff --cached --quiet -- $CHECKED && exit 0
if ! command -v npm >/dev/null 2>&1 || [ ! -d node_modules ]; then
  echo "Commit blocked: npm or node_modules is missing here. Run 'npm ci' in $(pwd), then commit again." >&2
  exit 1
fi
# The checks run on the working tree: unstaged edits in these files would be tested but not committed.
# shellcheck disable=SC2086
if ! git diff --quiet -- $CHECKED; then
  echo "Commit blocked: these files have unstaged changes, so the checks would not test what you commit:" >&2
  # shellcheck disable=SC2086
  git diff --name-only -- $CHECKED | sed 's/^/  /' >&2
  echo "Stage them (git add) or set them aside (git stash push --keep-index), then commit again." >&2
  exit 1
fi
log=$(mktemp)
trap 'rm -f "$log"' EXIT
# BB-86: app.js is the esbuild bundle of src/. Rebuild; if that changed it, the commit would ship a stale bundle.
if ! npm run --silent build >"$log" 2>&1; then
  { echo "Commit blocked: 'npm run build' failed."; tail -40 "$log"; } >&2
  exit 1
fi
if ! git diff --quiet -- app.js app.js.map; then
  echo "Commit blocked: app.js was out of date with src/ and has just been rebuilt. Add app.js and app.js.map to this commit ('git add app.js app.js.map', or list them in 'git commit <files>'), then commit again." >&2
  exit 1
fi
# BB-79: lint and formatting first, they take a second.
if ! { npm run --silent lint && npm run --silent format:check; } >"$log" 2>&1; then
  { echo "Commit blocked: 'npm run lint' or 'npm run format:check' failed. Run 'npm run format', fix the lint errors, then commit again."; tail -40 "$log"; } >&2
  exit 1
fi
if npm run --silent test:engine >"$log" 2>&1 && npm run --silent test:chrome >"$log" 2>&1; then
  exit 0
fi
{
  echo "Commit blocked: 'npm run test:engine' or 'npm run test:chrome' failed. Fix the page (don't loosen tests), then commit again."
  tail -40 "$log"
} >&2
exit 1
