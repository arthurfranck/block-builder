{
  "name": "block-builder",
  "private": true,
  "description": "Automated tests for Block Builder. The app itself is index.html and needs no install.",
  "scripts": {
    "test": "node --test tests/engine/*.unit.mjs && playwright test",
    "test:engine": "node --test tests/engine/*.unit.mjs",
    "test:desktop": "playwright test --project=desktop-*",
    "test:mobile": "playwright test --project=iphone-*",
    "test:chrome": "playwright test --project=desktop-chrome",
    "test:report": "playwright show-report",
    "typecheck": "tsc -p . && tsc -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write src/*.js theme.js eslint.config.mjs",
    "format:check": "prettier --check src/*.js theme.js eslint.config.mjs",
    "build": "esbuild src/app.js --bundle --format=iife --target=es2022 --sourcemap --external:./vendor/* --legal-comments=none --banner:js=\"/* Block Builder: built from src/ by esbuild (npm run build). Edit src/, not this file. */\" --outfile=app.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "^7.0.2"
  }
}
